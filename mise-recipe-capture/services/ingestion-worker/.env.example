# Safe local examples only. Leave all secrets blank.
ENVIRONMENT=development
WORKER_ID=local-worker
WORKER_SHARED_SECRET=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
TEMP_ROOT=/tmp/mise-ingestion
TEMP_DISK_LIMIT_GB=5
RAW_MEDIA_TTL_HOURS=24
REVIEW_PROXY_TTL_HOURS=24
JOB_TIMEOUT_SECONDS=3600
MAX_REDIRECTS=5
MAX_DOWNLOAD_BYTES=524288000
ASR_PROVIDER=not-configured
ASR_API_KEY=
OCR_PROVIDER=not-configured
OCR_API_KEY=
EXTRACTION_PROVIDER=not-configured
EXTRACTION_API_KEY=
TRANSLATION_PROVIDER=not-configured
TRANSLATION_API_KEY=
PLATFORM_COOKIE_FILE_PATH=
HTTP_PROXY=
HTTPS_PROXY=
FIXTURE_MODE_ENABLED=true
