{
  "name": "mise-recipe-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Turn social cooking videos into traceable, bilingual recipes.",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @mise/client dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @mise/client test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  }
}
